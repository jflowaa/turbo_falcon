[Unit]
Description=turbo-falcon compose stack
Wants=network-online.target
After=network-online.target platform-compose.service
Requires=platform-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/turbo-falcon
ExecStart=/usr/bin/podman-compose -p turbo-falcon up -d --remove-orphans
ExecStop=/usr/bin/podman-compose -p turbo-falcon down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
